# ============================================
# Papertrail Backend Environment Variables
# ============================================

# Server Port
PORT=5000

# Environment Mode: development | production
NODE_ENV=development

# MongoDB Connection String (Atlas or Local MongoDB)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/papertrail?retryWrites=true&w=majority
# Local Example: mongodb://127.0.0.1:27017/papertrail
MONGO_URI=mongodb://127.0.0.1:27017/papertrail

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://localhost:3000
